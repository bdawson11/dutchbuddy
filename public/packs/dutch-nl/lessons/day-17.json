      "answers": ["mijn zus"]
    },
    {
      "type": "typed",
      "prompt": "Type 'her brother' in Dutch.",
      "answers": ["haar broer"]
    },
    {
      "type": "builder",
      "prompt": "Show a photo — introduce someone.",
      "slots": [
        { "label": "Possessive", "chips": ["mijn", "jouw", "zijn", "haar", "ons", "onze", "hun"] },
        { "label": "Person or place", "chips": ["moeder", "broer", "huis", "stad", "zusje"] }
      ],
      "sample": "Dit is mijn moeder."
    },
    {
      "type": "dialogue",
      "scene": "You and Daan scroll through phone photos.",
      "lines": [
        { "speaker": "Daan", "nl": "Wie is dit?", "en": "Who's this?" },
        { "speaker": "You", "nl": "Dit is mijn oma. En dat is haar huis.", "en": "This is my grandma. And that's her house." },
        { "speaker": "Daan", "nl": "Gezellig! En die twee?", "en": "Cozy! And those two?" },
        { "speaker": "You", "nl": "Dat zijn Emma en Sanne — dit is hun buurt.", "en": "That's Emma and Sanne — this is their neighborhood.", "spotlight": "hun — their, for zij (mv)." },
        { "speaker": "Daan", "nl": "O, die ken ik! Onze stad is best klein, hoor.", "en": "Oh, I know that! Our city is pretty small.", "spotlight": "onze — stad is a de-word." }
      ]
    },
    {
      "type": "comprehension",
