  "summary": "Possessives (mijn, jouw, zijn, haar, ons/onze, hun) for showing off photos",
  "blocks": [
    {
      "type": "card",
      "title": "My, your, his, her...",
      "body": "Every pronoun has a matching possessive: *ik* → *mijn*, *jij/je* → *jouw/je*, *u* → *uw*, *hij* → *zijn*, *zij* → *haar*, *wij* → *ons/onze*, *jullie* → *jullie*, *zij (mv)* → *hun*.",
      "table": {
        "headers": ["Person", "Possessive"],
        "rows": [
          ["ik — I", "mijn — my"],
          ["jij/je — you", "jouw/je — your"],
          ["u — you (formal)", "uw — your"],
          ["hij — he", "zijn — his"],
          ["zij — she", "haar — her"],
          ["wij — we", "ons/onze — our"],
          ["jullie — you all", "jullie — your"],
          ["zij (mv) — they", "hun — their"]
        ]
      }
    },
    {
      "type": "chips",
      "title": "Tap to hear them",
      "items": [
        { "nl": "mijn", "en": "my", "speak": "mijn" },
        { "nl": "jouw", "en": "your", "speak": "jouw" },
        { "nl": "uw", "en": "your (formal)", "speak": "uw" },
        { "nl": "zijn", "en": "his", "speak": "zijn" },
        { "nl": "haar", "en": "her", "speak": "haar" },
        { "nl": "ons", "en": "our (het-words)", "speak": "ons" },
        { "nl": "onze", "en": "our (de-words/plural)", "speak": "onze" },
        { "nl": "hun", "en": "their", "speak": "hun" }
      ]
    },
    {
      "type": "contrast",
      "title": "ons vs onze",
      "pairs": [
        { "left": "ons huis — our house", "right": "onze stad — our city", "note": "*ons* only appears before a singular het-word. *onze* covers de-words and every plural: *onze huizen* too." }
      ]
    },
    {
      "type": "mcq",
      "prompt": "Which is correct — 'our house' (huis is het)?",
      "options": ["ons huis", "onze huis"],
      "correct": 0,
      "explain": "ons huis — het-word, singular, so *ons*."
    },
    {
      "type": "typed",
