    {
      "type": "card",
      "title": "sich fühlen — ein reflexives Verb",
      "body": "**sich fühlen** (to feel) is reflexive — the pronoun changes with the subject, same pattern as other reflexive verbs. *Ich fühle mich müde* (I feel tired).",
      "table": {
        "headers": ["Person", "fühlen + reflexiv"],
        "rows": [
          ["ich", "fühle mich"],
          ["du", "fühlst dich"],
          ["er / sie / es", "fühlt sich"],
          ["wir", "fühlen uns"],
          ["ihr", "fühlt euch"],
          ["sie / Sie", "fühlen sich"]
        ]
      },
      "callout": "Ich fühle mich — always with mich, never ich fühle alone."
    },
    {
      "type": "mcq",
      "prompt": "Complete: 'Sie fühlt ___ nervös.'",
      "options": ["mich", "sich", "uns"],
      "correct": 1,
      "explain": "Third person singular (er/sie/es) takes sich: sie fühlt sich nervös."
    },
    {
      "type": "contrast",
      "title": "sein vs. sich fühlen",
      "pairs": [
        {
          "left": "Ich bin müde. — I am tired. (simple state)",
          "right": "Ich fühle mich müde. — I feel tired. (sich fühlen)",
          "note": "Both correct — sich fühlen is more personal, about how you feel right now."
        }
      ]
    },
    {
      "type": "typed",
      "prompt": "Type: 'I feel nervous.'",
      "answers": ["Ich fühle mich nervös", "Ich fuehle mich nervoes"],
      "hint": "sich fühlen, ich-form",
      "explain": "Ich fühle mich nervös — mich matches ich."
