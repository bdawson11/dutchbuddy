  "blocks": [
    {
      "type": "card",
      "title": "Immer Akkusativ: für, ohne, gegen, um, durch",
      "body": "Five little prepositions always pull the accusative, no matter what: **für** (for), **ohne** (without), **gegen** (against), **um** (around/at), **durch** (through). Memorize them as a set and the case is automatic — *für meinen Bruder, ohne dich, durch den Park*.",
      "table": {
        "headers": ["Präposition", "Bedeutung", "Beispiel"],
        "rows": [
          ["für", "for", "für meine Schwester"],
          ["ohne", "without", "ohne meinen Bruder"],
          ["gegen", "against", "gegen den Wind"],
          ["um", "around / at", "um die Ecke"],
          ["durch", "through", "durch den Park"]
        ]
      }
    },
    {
      "type": "chips",
      "title": "Tap to hear the phrases",
      "items": [
        { "nl": "für meinen Bruder", "en": "for my brother", "speak": "für meinen Bruder" },
        { "nl": "ohne dich", "en": "without you", "speak": "ohne dich" },
        { "nl": "gegen den Wind", "en": "against the wind", "speak": "gegen den Wind" },
        { "nl": "um die Ecke", "en": "around the corner", "speak": "um die Ecke" },
        { "nl": "durch den Park", "en": "through the park", "speak": "durch den Park" },
        { "nl": "für den Feierabend", "en": "for after-work time", "speak": "für den Feierabend" }
      ]
    },
    {
      "type": "contrast",
      "title": "Subject vs. after the preposition",
      "pairs": [
        { "left": "der Park — subject", "right": "durch den Park — after durch", "note": "Masculine 'der' becomes 'den' after any of the five." },
        { "left": "die Ecke — subject", "right": "um die Ecke — after um", "note": "Feminine never changes." },
        { "left": "der Wind — subject", "right": "gegen den Wind — after gegen", "note": "Same masculine move again." }
      ]
    },
    {
      "type": "mcq",
      "prompt": "Complete: 'Ich gehe ___ Park.' (through the park)",
      "options": ["durch der", "durch den", "durch die"],
      "correct": 1,
      "explain": "*durch* always takes accusative — masculine *der Park* → *den Park*."
    },
